<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="parent_anchor" prefHeight="355.0" prefWidth="220.0" styleClass="anchor-pane"
            stylesheets="@../../CSSstyles/growStagebig.css" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.jdta.growapp.Controllers.ToolsControlls.GrowStageEditController">
   <Label fx:id="set_edit_error_lbl" layoutX="52.0" layoutY="3.0" prefHeight="17.0" prefWidth="135.0"
          stylesheets="@../../CSSstyles/growStagebig.css" text="Set / Edit Grow Stage" AnchorPane.leftAnchor="45.0" AnchorPane.topAnchor="2.0" />
   <Label fx:id="current_stage_name_days_lbl" layoutX="14.0" layoutY="51.0" stylesheets="@../../CSSstyles/growStagebig.css" text="current StageName __Days" AnchorPane.leftAnchor="4.0" AnchorPane.topAnchor="30.0" />
   <ChoiceBox fx:id="stage_select_choice_box" layoutX="9.0" layoutY="47.0" prefWidth="150.0" AnchorPane.leftAnchor="2.0" AnchorPane.topAnchor="50.0">
      <cursor>
         <Cursor fx:constant="OPEN_HAND" />
      </cursor></ChoiceBox>
   <Button fx:id="set_stage" layoutX="9.0" layoutY="316.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="62.0" text="Set Stage" AnchorPane.topAnchor="316.0" />
   <Label fx:id="start_stage_days_lbl" layoutX="14.0" layoutY="109.0" text="Waiting germination _days" AnchorPane.leftAnchor="6.0" AnchorPane.topAnchor="85.0" />
   <Label fx:id="germinated_days_lbl" layoutX="14.0" layoutY="136.0" text="First Leafs __days" AnchorPane.leftAnchor="6.0" AnchorPane.topAnchor="105.0" />
   <Label fx:id="vegetation_days_lbl" layoutX="14.0" layoutY="161.0" text="Vegetation __days" AnchorPane.leftAnchor="6.0" AnchorPane.topAnchor="125.0" />
   <Label fx:id="pre_flow_days_lbl" layoutX="14.0" layoutY="186.0" text="Pre Flowering __days" AnchorPane.leftAnchor="6.0" AnchorPane.topAnchor="145.0" />
   <Label fx:id="flow_days_lbl" layoutX="14.0" layoutY="209.0" text="Flowering __days" AnchorPane.leftAnchor="6.0" AnchorPane.topAnchor="165.0" />
   <CheckBox fx:id="clean_check" layoutX="4.0" layoutY="188.0" mnemonicParsing="false" text="Cleaning" AnchorPane.leftAnchor="4.0" AnchorPane.topAnchor="192.0">
      <cursor>
         <Cursor fx:constant="HAND" />
      </cursor></CheckBox>
   <CheckBox fx:id="harvest_check" layoutX="119.0" layoutY="189.0" mnemonicParsing="false" text="Harvest" AnchorPane.leftAnchor="123.0" AnchorPane.topAnchor="192.0">
      <cursor>
         <Cursor fx:constant="HAND" />
      </cursor></CheckBox>
   <TextField fx:id="days_grams_in_fld" layoutX="36.0" layoutY="275.0" prefHeight="25.0" prefWidth="97.0" promptText="days / grams" styleClass="input_field" AnchorPane.leftAnchor="35.0" AnchorPane.topAnchor="274.0" />
   <RadioButton fx:id="drying_rb" layoutX="2.0" layoutY="219.0" mnemonicParsing="false" stylesheets="@../../CSSstyles/growStagebig.css" text="EnterDryingDays" AnchorPane.leftAnchor="4.0" AnchorPane.topAnchor="222.0">
      <cursor>
         <Cursor fx:constant="HAND" />
      </cursor></RadioButton>
   <RadioButton fx:id="yield_rb" layoutX="123.0" layoutY="219.0" mnemonicParsing="false" text="Enter YIELD " AnchorPane.leftAnchor="123.0" AnchorPane.topAnchor="222.0">
      <cursor>
         <Cursor fx:constant="HAND" />
      </cursor></RadioButton>
   <Label fx:id="drying_or_yield_lbl" layoutX="20.0" layoutY="250.0" prefHeight="17.0" prefWidth="172.0" text="Enter DryingDays / YIELD gr" AnchorPane.leftAnchor="19.0" AnchorPane.topAnchor="249.0" />
   <Label fx:id="total_days_lbl" layoutX="79.0" layoutY="324.0" prefHeight="17.0" prefWidth="135.0" text="Total  growing ___days" AnchorPane.leftAnchor="77.0" />
   <Button fx:id="add_btn" layoutX="152.0" layoutY="272.0" mnemonicParsing="false" prefHeight="25.0" text="Add" />
</AnchorPane>
