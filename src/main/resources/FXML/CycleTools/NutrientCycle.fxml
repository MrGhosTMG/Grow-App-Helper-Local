<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="parent_nutr" prefHeight="355.0" prefWidth="220.0" styleClass="nuts_container" stylesheets="@../../CSSstyles/nutsStyle.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.jdta.growapp.Controllers.ToolsControlls.NutrientsController">
    <VBox layoutX="7.0" layoutY="1.0" prefHeight="355.0" prefWidth="220.0" AnchorPane.leftAnchor="7.0" AnchorPane.rightAnchor="6.0" AnchorPane.topAnchor="1.0">
        <Text fill="#0adfee" strokeType="OUTSIDE" strokeWidth="0.0" text="Add manually">
          <VBox.margin>
              <Insets left="55.0" />
          </VBox.margin>
        </Text>
        <TextField fx:id="nut_name_fld" prefHeight="25.0" prefWidth="75.0" promptText="Enter nutr_name" styleClass="input_field">
          <cursor>
              <Cursor fx:constant="TEXT" />
          </cursor>
        </TextField>
      <CheckBox fx:id="add_new_activ" mnemonicParsing="false" text="Add new">
         <VBox.margin>
            <Insets left="2.0" />
         </VBox.margin>
      </CheckBox>
      <Text fill="#b9e509" strokeType="OUTSIDE" strokeWidth="0.0" text="NPK Information">
         <VBox.margin>
            <Insets left="55.0" />
         </VBox.margin>
      </Text>
        <VBox prefHeight="200.0" prefWidth="100.0">
            <TextField fx:id="N_fld" prefHeight="25.0" prefWidth="87.0" promptText="N">
                <VBox.margin>
                    <Insets left="2.0" right="2.0" />
                </VBox.margin>
            </TextField>
            <TextField fx:id="P_fld" layoutX="10.0" layoutY="100.0" promptText="P">
                <VBox.margin>
                    <Insets left="2.0" right="2.0" />
                </VBox.margin>
            </TextField>
            <TextField fx:id="K_fld" layoutX="10.0" layoutY="125.0" promptText="K">
                <VBox.margin>
                    <Insets left="2.0" right="2.0" />
                </VBox.margin>
            </TextField>
            <TextArea fx:id="nutr_add_desc_text" prefHeight="105.0" prefWidth="98.0" promptText="Descriptions, info,notes" wrapText="true">
                <VBox.margin>
                    <Insets left="2.0" right="2.0" />
                </VBox.margin>
            </TextArea>
        </VBox>
        <Button fx:id="save_to_list_btn" mnemonicParsing="false" prefWidth="96.0" styleClass="Button" stylesheets="@../../CSSstyles/nutsStyle.css" text="Save to lists">
            <graphic>
                <FontAwesomeIconView glyphName="CHECK" styleClass="FontAwesomeIconView" />
            </graphic>
          <VBox.margin>
              <Insets left="50.0" top="2.0" />
          </VBox.margin>
        </Button>
        <Text fill="#0adfee" strokeType="OUTSIDE" strokeWidth="0.0" text="Pick from list">
          <VBox.margin>
              <Insets left="4.0" top="2.0" />
          </VBox.margin>
        </Text>
        <ChoiceBox fx:id="choose_nuts" prefHeight="25.0" prefWidth="204.0" styleClass="input_field">
          <VBox.margin>
              <Insets left="2.0" top="2.0" />
          </VBox.margin>
        </ChoiceBox>
        <Button fx:id="add_nut_in_cycle_btn" mnemonicParsing="false" prefHeight="25.0" prefWidth="96.0" styleClass="Button" text="Add to cycle">
          <graphic>
              <FontAwesomeIconView glyphName="PLUS" styleClass="alt_FontAwesomeIconView" />
          </graphic>
          <VBox.margin>
              <Insets left="50.0" top="2.0" />
          </VBox.margin>
        </Button>
         <ListView fx:id="desc_picked_nut_text" prefHeight="160.0" prefWidth="200.0" styleClass="readonly-area">
             <cursor>
                 <Cursor fx:constant="TEXT" />
             </cursor>
         <VBox.margin>
            <Insets bottom="4.0" left="2.0" right="2.0" top="2.0" />
         </VBox.margin>
         </ListView>
    </VBox>
</AnchorPane>
