<AnchorPane prefHeight="355.0" prefWidth="220.0" styleClass="alarms_main" stylesheets="@../../CSSstyles/Alarms.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.jdta.growapp.Controllers.ToolsControlls.AlarmsController">
   <DatePicker fx:id="date_picker" layoutX="106.0" layoutY="23.0" prefHeight="25.0" prefWidth="110.0" AnchorPane.topAnchor="25.0" />
   <Label fx:id="info_lbl" layoutX="90.0" layoutY="170.0" prefHeight="35.0" prefWidth="127.0" text="info / error" wrapText="true" AnchorPane.topAnchor="169.0" />
