      </Button>
      <Button fx:id="train_btn" mnemonicParsing="false" prefHeight="25.0" prefWidth="80.0" text="Training">
         <VBox.margin>
            <Insets top="4.0" />
         </VBox.margin>
      </Button>
   </VBox>
   <Line endX="104.0" layoutX="110.0" layoutY="207.0" startX="-106.0" />
   <ListView fx:id="list_alarms_view" layoutX="4.0" layoutY="237.0" prefHeight="115.0" prefWidth="212.0" />
