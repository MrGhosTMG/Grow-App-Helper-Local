   <Button fx:id="text_note_btn" layoutX="122.0" layoutY="132.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="92.0" text="Add text note" AnchorPane.leftAnchor="122.0" AnchorPane.topAnchor="132.0" />
