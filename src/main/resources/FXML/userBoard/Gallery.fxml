<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane fx:id="parent_anchor" maxHeight="355.0" maxWidth="220.0" prefHeight="355.0" prefWidth="220.0" styleClass="main_container" stylesheets="@../../CSSstyles/Gallery.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.jdta.growapp.Controllers.ToolsControlls.GalleryController">
   <HBox layoutX="10.0" layoutY="6.0" prefHeight="30.0" prefWidth="200.0">
      <Button fx:id="add_photo_btn" mnemonicParsing="false" text="Add new Photo" />
      <Button fx:id="delete_photo_btn" mnemonicParsing="false" text="Delete Photo">
         <HBox.margin>
            <Insets left="15.0" />
         </HBox.margin>
      </Button>
   </HBox>
   <ScrollPane fx:id="scrl_pane" layoutX="4.0" layoutY="36.0" prefHeight="284.0" prefWidth="214.0">
      <StackPane fx:id="stack_pane" prefHeight="283.0" prefWidth="200.0" styleClass="photo_container" stylesheets="@../../CSSstyles/Gallery.css">
         <GridPane fx:id="grid_pane" hgap="10" prefHeight="257.0" prefWidth="128.0" stylesheets="@../../CSSstyles/Gallery.css" vgap="10" />
         <ProgressIndicator fx:id="loader_spinner" maxHeight="177.0" maxWidth="190.0" prefHeight="171.0" prefWidth="190.0" visible="false" />

      </StackPane>
   </ScrollPane>
   <Button fx:id="del_all" layoutX="75.0" layoutY="324.0" mnemonicParsing="false" text="Delete All" />
</AnchorPane>
