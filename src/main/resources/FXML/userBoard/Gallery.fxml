<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane fx:id="parent_anchor" prefHeight="355.0" prefWidth="220.0" styleClass="main_container"
            stylesheets="@../../CSSstyles/Gallery.css" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.jdta.growapp.Controllers.ToolsControlls.GalleryController">
   <HBox layoutX="10.0" layoutY="6.0" prefHeight="30.0" prefWidth="200.0">
      <Button fx:id="add_photo_btn" mnemonicParsing="false" text="Add new Photo" />
      <Button fx:id="delete_photo_btn" mnemonicParsing="false" text="Delete Photo">
         <HBox.margin>
            <Insets left="15.0" />
         </HBox.margin>
      </Button>
   </HBox>
   <StackPane fx:id="stack_pane" layoutX="4.0" layoutY="44.0" prefHeight="275.0" prefWidth="210.0" styleClass="photo_container" stylesheets="@../../CSSstyles/Gallery.css">
      <GridPane fx:id="grid_pane" hgap="10" prefHeight="257.0" prefWidth="128.0" stylesheets="@../../CSSstyles/photo.css" vgap="10" />
   </StackPane>
   <Button fx:id="del_all" layoutX="75.0" layoutY="324.0" mnemonicParsing="false" text="Delete All" />
   <ProgressIndicator fx:id="loader_spinner" layoutX="14.0" layoutY="107.0" maxHeight="233.0" maxWidth="210.0"
                      prefHeight="190.0" prefWidth="190.0" stylesheets="@../../CSSstyles/Gallery.css" visible="false" />
</AnchorPane>
