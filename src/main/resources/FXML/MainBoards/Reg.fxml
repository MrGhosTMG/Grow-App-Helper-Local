            <padding>
                <Insets left="2.0" />
            </padding>
        </Label>
        <PasswordField fx:id="password_fld" alignment="CENTER" promptText="password" styleClass="input_field">
            <VBox.margin>
                <Insets top="2.0" />
            </VBox.margin>
        </PasswordField>
        <Label fx:id="pass_lbl" layoutX="10.0" layoutY="77.0" text="password min - 8 any symbols ">
            <VBox.margin>
                <Insets top="2.0" />
            </VBox.margin>
            <padding>
                <Insets left="2.0" />
            </padding>
        </Label>
        <PasswordField fx:id="password_check_fld" alignment="CENTER" layoutX="10.0" layoutY="94.0" promptText="password again" styleClass="input_field">
