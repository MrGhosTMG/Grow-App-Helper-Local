            </VBox.margin>
        </PasswordField>
        <Label fx:id="pass_check_lbl" layoutX="10.0" layoutY="133.0" text="password check">
            <padding>
                <Insets left="2.0" />
            </padding>
        </Label>
        <CheckBox fx:id="accept_terms_ch_box" mnemonicParsing="false" text="Read and accept terms">
            <VBox.margin>
                <Insets left="4.0" top="10.0" />
            </VBox.margin>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
        </CheckBox>
        <ScrollPane fx:id="scrl_pane" prefHeight="200.0" prefWidth="200.0">
            <VBox.margin>
                <Insets top="4.0"/>
