                <FontAwesomeIconView fill="#e80606" glyphName="CLOSE" size="15" styleClass="main_reg_container" />
            </graphic>
        </Button>
    </VBox>
    <FontAwesomeIconView glyphName="ADDRESS_BOOK_ALT" layoutX="148.0" layoutY="23.0" size="16" styleClass="FontAwesomeIconView" tabSize="10" AnchorPane.topAnchor="12.0" />
