    <VBox layoutX="295.0" layoutY="40.0" prefHeight="400.0" prefWidth="120.0" styleClass="main_reg_container_r" stylesheets="@../../CSSstyles/regStylesheet.css" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="40.0">
        <FontAwesomeIconView glyphName="LEAF" size="65" styleClass="FontAwesomeIconView">
